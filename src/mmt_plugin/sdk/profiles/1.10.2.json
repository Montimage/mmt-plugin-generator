    {"name": "MMT_U64_DATA", "header": "types_defs.h", "group": "data_type", "doc": "PDL type MMT_U64_DATA."},
    {"name": "MMT_DATA_POINTER", "header": "types_defs.h", "group": "data_type", "doc": "PDL type MMT_DATA_POINTER."},
    {"name": "MMT_DATA_MAC_ADDR", "header": "types_defs.h", "group": "data_type", "doc": "PDL type MMT_DATA_MAC_ADDR."},
    {"name": "MMT_DATA_IP_NET", "header": "types_defs.h", "group": "data_type", "doc": "PDL type MMT_DATA_IP_NET."},
    {"name": "MMT_DATA_IP_ADDR", "header": "types_defs.h", "group": "data_type", "doc": "PDL type MMT_DATA_IP_ADDR."},
    {"name": "MMT_DATA_IP6_ADDR", "header": "types_defs.h", "group": "data_type", "doc": "PDL type MMT_DATA_IP6_ADDR."},
