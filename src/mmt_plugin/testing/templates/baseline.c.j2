{#-
  The empty plugin of mmt-plugin test --bench: the protocol's id and name,
  no attribute, so the harness measures mmt-dpi and the classification
  alone. Every SDK name comes from the profile.
-#}
/*
 * The empty baseline plugin of {{ name }} (protocol {{ proto_id }}, SDK profile {{ profile }}).
 *
 * Generated by mmt-plugin test --bench: it registers the protocol with no
 * attribute, so the packets per second of the harness with it are the cost
 * of mmt-dpi and the classification alone.
 */
{% for include in includes %}
#include "{{ include }}"
{% endfor %}

int init_proto(void);

int init_proto(void)
{
    {{ protocol_t }} *protocol_struct = {{ init_struct }}({{ proto_id }}, "{{ name }}");

    if (protocol_struct == NULL) {
        return 0;
    }
    return {{ register_protocol }}(protocol_struct, {{ proto_id }}) ? 1 : 0;
}
