{#-
  The capture runner of mmt-plugin run (mmt_plugin.capture.runner renders
  it, in memory, for one SDK profile). It only calls mmt-dpi's public host
  API (init_extraction, mmt_init_handler, packet_process, the protocol and
  attribute lookups); the compile against the SDK headers checks them. The
  profile gives the names of the data types, to report each attribute's.
-#}
/*
 * The mmt-plugin run capture runner (SDK profile {{ profile }}).
 *
 * Generated by mmt-plugin run; rebuilt when it changes. It loads the
 * plugins of $MMT_DPI_PLUGINS_DIR with init_extraction(), opens a handler
 * for link type DLT, and processes the frames it reads on stdin, one at a
 * time in one buffer, through mmt-dpi's stack: nothing attaches a protocol,
 * so the plugins' own parent classification must find their packets.
 *
 *   runner DLT PROTO [PROTO...]
 *
 * PROTO are protocols, by id (digits) or by name: the first is the
 * plugin's, which must be registered; each one's attributes are all
 * registered for extraction.
 * A record on stdin is the captured length and the length on the wire
 * (4 bytes each), the seconds (8 bytes) and nanoseconds (4 bytes) of its
 * time stamp, little-endian, then the captured bytes.
 *
 * Output, on the original stdout (file descriptor 1 then points at stderr,
 * so the plugins' own output never mixes with it):
 *
 *   protocol I ID NAME | unknown I PROTO    each PROTO, in order
 *   attribute I ID TYPE NAME                each attribute of protocol I
 *   ready                                   the setup is done
 *   progress N                              every 65536 frames
 *   crash N                                 a fatal signal in frame N
 * then, after the last record:
 *   frames N UNPROCESSED                    frames read, and those
 *                                           packet_process() refused
 *   classified I N                          packets with protocol I
 *   count I K N                             packets with I's K-th attribute
 *   path N ID...                            packets per protocol path
 *   paths_other N                           packets of paths not kept
 *   name ID NAME                            each protocol of a kept path
 *   end N
 *
 * Its memory does not depend on the number of frames: one frame buffer
 * (the largest frame), at most RUNNER_PATHS paths, and mmt-dpi's own
 * session tables, which the time stamps expire.
 *
 * Exit status: 0, or 3 with an "error" line when the setup fails or a
 * record is cut short.
 */
#include <signal.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>

#include "mmt_core.h"

#define RUNNER_PROTOCOLS 16
#define RUNNER_ATTRIBUTES 256
#define RUNNER_PATHS 1024
#define RUNNER_SLOTS 2048 /* a power of two, twice RUNNER_PATHS */
#define RUNNER_DEPTH 16
#define RUNNER_RECORD 20
#define RUNNER_PROGRESS 65536

struct runner_type {
    int id;
    const char *name;
};

/* The data types of the profile, to print the type of each attribute. */
static const struct runner_type runner_types[] = {
{% for t in types %}
    {{ '{' }}{{ t }}, "{{ t }}"{{ '}' }},
{% endfor %}
};

struct runner_attribute {
    uint32_t id;
    uint64_t packets;
};

struct runner_protocol {
    uint32_t id; /* 0: not registered */
    uint64_t packets;
    size_t count;
    struct runner_attribute attributes[RUNNER_ATTRIBUTES];
};

struct runner_path {
    int used;
    int len;
    uint32_t ids[RUNNER_DEPTH];
    uint64_t packets;
};

static struct runner_protocol runner_protocols[RUNNER_PROTOCOLS];
static size_t runner_nprotocols;
static struct runner_path runner_paths[RUNNER_SLOTS];
static size_t runner_npaths;
static uint64_t runner_paths_other;
/* The frame being processed (1-based); the signal handler reports it. */
static uint64_t runner_frame;
static int runner_fd;
static FILE *runner_out;
static mmt_handler_t *runner_handler;

static const char *runner_type_name(int type)
{
    size_t i;

    for (i = 0; i < sizeof(runner_types) / sizeof(runner_types[0]); i++) {
        if (runner_types[i].id == type) {
            return runner_types[i].name;
        }
    }
    return "MMT_UNDEFINED_TYPE";
}

/* Async-signal-safe: "crash N\n" with write(), then the default action. */
static void runner_crash(int sig)
{
    char line[48];
    char digits[24];
    uint64_t n = runner_frame;
    size_t k = 0, len = 0;

    memcpy(line, "crash ", 6);
    len = 6;
    do {
        digits[k++] = (char) ('0' + n % 10);
        n /= 10;
    } while (n > 0 && k < sizeof(digits));
    while (k > 0) {
        line[len++] = digits[--k];
    }
    line[len++] = '\n';
    if (write(runner_fd, line, len) < 0) {
        /* nothing more can be done in a signal handler */
    }
    signal(sig, SIG_DFL);
    raise(sig);
}

static void runner_attribute(attribute_metadata_t *attribute, uint32_t proto_id, void *args)
{
    struct runner_protocol *p = args;

    (void) proto_id;
    if (p->count < RUNNER_ATTRIBUTES) {
        p->attributes[p->count].id = (uint32_t) attribute->id;
        p->attributes[p->count].packets = 0;
        p->count++;
    }
}

static void runner_count_path(const ipacket_t *ipacket)
{
    const proto_hierarchy_t *h = ipacket->proto_hierarchy;
    uint32_t ids[RUNNER_DEPTH];
    uint64_t hash = 1469598103934665603u;
    int len = h->len < RUNNER_DEPTH ? h->len : RUNNER_DEPTH;
    size_t slot;
    int i;

    for (i = 0; i < len; i++) {
        ids[i] = (uint32_t) h->proto_path[i];
        hash = (hash ^ ids[i]) * 1099511628211u;
    }
    hash = (hash ^ (uint64_t) len) * 1099511628211u;
    slot = (size_t) (hash & (RUNNER_SLOTS - 1));
    while (runner_paths[slot].used) {
        if (runner_paths[slot].len == len && memcmp(runner_paths[slot].ids, ids, (size_t) len * sizeof(ids[0])) == 0) {
            runner_paths[slot].packets++;
            return;
        }
        slot = (slot + 1) & (RUNNER_SLOTS - 1);
    }
    if (runner_npaths >= RUNNER_PATHS) {
        runner_paths_other++;
        return;
    }
    runner_paths[slot].used = 1;
    runner_paths[slot].len = len;
    memcpy(runner_paths[slot].ids, ids, (size_t) len * sizeof(ids[0]));
    runner_paths[slot].packets = 1;
    runner_npaths++;
}

static int runner_packet(const ipacket_t *ipacket, void *user)
{
    size_t i, k;

    (void) user;
    runner_count_path(ipacket);
    for (i = 0; i < runner_nprotocols; i++) {
        struct runner_protocol *p = &runner_protocols[i];

        if (p->id == 0 || get_protocol_index_by_id(ipacket, p->id) == MMT_NO_PROTO_INDEX) {
            continue;
        }
        p->packets++;
        for (k = 0; k < p->count; k++) {
            if (get_attribute_extracted_data(ipacket, p->id, p->attributes[k].id) != NULL) {
                p->attributes[k].packets++;
            }
        }
    }
    return 0;
}

static uint64_t runner_le(const unsigned char *p, size_t n)
{
    uint64_t v = 0;

    while (n-- > 0) {
        v = v << 8 | p[n];
    }
    return v;
}

static int runner_fail(const char *message)
{
    fprintf(runner_out, "error %s\n", message);
    fflush(runner_out);
    return 3;
}

static int runner_seen(const uint32_t *seen, size_t n, uint32_t id)
{
    size_t i;

    for (i = 0; i < n; i++) {
        if (seen[i] == id) {
            return 1;
        }
    }
    return 0;
}

static void runner_report(uint64_t unprocessed)
{
    static uint32_t seen[RUNNER_PATHS * RUNNER_DEPTH];
    size_t nseen = 0, i, k;
    int j;

    fprintf(runner_out, "frames %llu %llu\n", (unsigned long long) runner_frame, (unsigned long long) unprocessed);
    for (i = 0; i < runner_nprotocols; i++) {
        struct runner_protocol *p = &runner_protocols[i];

        if (p->id == 0) {
            continue;
        }
        fprintf(runner_out, "classified %u %llu\n", (unsigned) i, (unsigned long long) p->packets);
        for (k = 0; k < p->count; k++) {
            fprintf(runner_out, "count %u %u %llu\n", (unsigned) i, (unsigned) k,
                    (unsigned long long) p->attributes[k].packets);
        }
    }
    for (i = 0; i < RUNNER_SLOTS; i++) {
        if (!runner_paths[i].used) {
            continue;
        }
        fprintf(runner_out, "path %llu", (unsigned long long) runner_paths[i].packets);
        for (j = 0; j < runner_paths[i].len; j++) {
            fprintf(runner_out, " %u", runner_paths[i].ids[j]);
            if (!runner_seen(seen, nseen, runner_paths[i].ids[j])) {
                seen[nseen++] = runner_paths[i].ids[j];
            }
        }
        fprintf(runner_out, "\n");
    }
    fprintf(runner_out, "paths_other %llu\n", (unsigned long long) runner_paths_other);
    for (i = 0; i < nseen; i++) {
        const char *name = get_protocol_name_by_id(seen[i]);

        fprintf(runner_out, "name %u %s\n", seen[i], name != NULL && name[0] != '\0' ? name : "?");
    }
    fprintf(runner_out, "end %llu\n", (unsigned long long) runner_frame);
    fflush(runner_out);
}

int main(int argc, char **argv)
{
    char error[MMT_ERRBUF_SIZE];
    unsigned char record[RUNNER_RECORD];
    unsigned char *buffer = NULL;
    size_t size = 0, caplen, got;
    uint64_t unprocessed = 0;
    struct pkthdr header;
    long dlt;
    int i;
    size_t k;

    /* Move the original stdout to a stream of its own and point stdout (and
       fd 1) at stderr, line buffered, before any plugin code runs. */
    runner_fd = dup(STDOUT_FILENO);
    if (runner_fd < 0 || (runner_out = fdopen(runner_fd, "w")) == NULL || dup2(STDERR_FILENO, STDOUT_FILENO) < 0) {
        fprintf(stderr, "runner: cannot set up its output\n");
        return 3;
    }
    setvbuf(stdout, NULL, _IOLBF, BUFSIZ);
    signal(SIGSEGV, runner_crash);
    signal(SIGBUS, runner_crash);
    signal(SIGFPE, runner_crash);
    signal(SIGILL, runner_crash);
    signal(SIGABRT, runner_crash);

    if (argc < 3 || argc - 2 > RUNNER_PROTOCOLS) {
        return runner_fail("usage: runner DLT PROTO [PROTO...]");
    }
    dlt = strtol(argv[1], NULL, 10);
    if (!init_extraction()) {
        return runner_fail("init_extraction() failed: a plugin did not load");
    }
    runner_handler = mmt_init_handler((int) dlt, 0, error);
    if (runner_handler == NULL) {
        return runner_fail("mmt_init_handler() failed: mmt-dpi does not read this link type");
    }
    for (i = 2; i < argc; i++) {
        struct runner_protocol *p = &runner_protocols[runner_nprotocols];
        char *end = NULL;
        unsigned long number = strtoul(argv[i], &end, 10);
        uint32_t id = argv[i][0] >= '0' && argv[i][0] <= '9' && end != NULL && *end == '\0'
                          ? (uint32_t) number
                          : get_protocol_id_by_name(argv[i]);

        if (id == 0 || id == (uint32_t) -1 || !is_registered_protocol(id)) {
            if (i == 2) {
                return runner_fail("the plugin did not register its protocol");
            }
            fprintf(runner_out, "unknown %u %s\n", (unsigned) runner_nprotocols, argv[i]);
            runner_nprotocols++;
            continue;
        }
        p->id = id;
        fprintf(runner_out, "protocol %u %u %s\n", (unsigned) runner_nprotocols, id, get_protocol_name_by_id(id));
        iterate_through_protocol_attributes(id, runner_attribute, p);
        for (k = 0; k < p->count; k++) {
            uint32_t attribute = p->attributes[k].id;

            if (!register_extraction_attribute(runner_handler, id, attribute)) {
                return runner_fail("cannot register an attribute for extraction");
            }
            fprintf(runner_out, "attribute %u %u %s %s\n", (unsigned) runner_nprotocols, attribute,
                    runner_type_name((int) get_attribute_data_type(id, attribute)),
                    get_attribute_name_by_protocol_and_attribute_ids(id, attribute));
        }
        runner_nprotocols++;
    }
    if (!register_packet_handler(runner_handler, 1, runner_packet, NULL)) {
        return runner_fail("cannot register the packet handler");
    }
    fprintf(runner_out, "ready\n");
    fflush(runner_out);

    while ((got = fread(record, 1, RUNNER_RECORD, stdin)) == RUNNER_RECORD) {
        caplen = (size_t) runner_le(record, 4);
        if (caplen > size) {
            unsigned char *grown = realloc(buffer, caplen);

            if (grown == NULL) {
                return runner_fail("out of memory for a frame");
            }
            buffer = grown;
            size = caplen;
        }
        if (caplen > 0 && fread(buffer, 1, caplen, stdin) != caplen) {
            return runner_fail("a record cut short on stdin");
        }
        runner_frame++;
        memset(&header, 0, sizeof(header));
        header.ts.tv_sec = (time_t) runner_le(record + 8, 8);
        header.ts.tv_usec = (suseconds_t) (runner_le(record + 16, 4) / 1000);
        header.caplen = (unsigned) caplen;
        header.len = (unsigned) runner_le(record + 4, 4);
        header.original_caplen = header.caplen;
        header.original_len = header.len;
        if (!packet_process(runner_handler, &header, buffer != NULL ? buffer : record)) {
            unprocessed++;
        }
        if (runner_frame % RUNNER_PROGRESS == 0) {
            fprintf(runner_out, "progress %llu\n", (unsigned long long) runner_frame);
            fflush(runner_out);
        }
    }
    if (got != 0) {
        return runner_fail("a record header cut short on stdin");
    }
    runner_report(unprocessed);
    mmt_close_handler(runner_handler);
    close_extraction();
    free(buffer);
    return 0;
}
