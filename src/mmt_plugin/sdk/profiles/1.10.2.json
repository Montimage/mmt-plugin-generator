{
  "$comment": "What code generated for mmt-dpi 1.10.2 uses from the SDK, and the header that declares each entry, relative to <prefix>/dpi/include. Taken from the headers of the published v1.10.2 package and checked against them in CI (python -m mmt_plugin.sdk.headercheck). Schema: mmt_plugin/schemas/sdk/v1/profile.json. Types are C type names; a parameter type never holds a function or array declarator, so '<type> <name>' declares it.",
  "schema_version": 1,
  "profile": "1.10.2",
  "sdk": "mmt-dpi",
  "c_std": "gnu11",
  "headers": [
    {
      "name": "data_defs.h",
      "doc": "Core types (ipacket_t, attribute_t, protocol_t, mmt_session_t), the packet accessors and the classification status values."
    },
    {
      "name": "types_defs.h",
      "doc": "The MMT_* attribute data types (enum data_types), mac_addr_t and the address and binary data lengths."
    },
    {
      "name": "mmt_core.h",
      "doc": "The attribute scopes, POSITION_NOT_KNOWN, and the VERSION macro that SDK detection reads."
    },
    {
      "name": "plugin_defs.h",
      "doc": "The plugin callback typedefs, attribute_metadata_t, classified_proto_t and the registration calls."
    },
    {
      "name": "extraction_lib.h",
      "doc": "The general_* extraction functions for fixed-width attributes."
    },
    {
      "name": "mmt_utils.h",
      "doc": "Utility helpers of libmmt_core (hexadecimal conversions); mmt_core.h includes it."
    },
    {
      "name": "mmt_log.h",
      "doc": "The SDK logger. No other installed header includes it: a plugin that logs includes it itself."
    },
    {
      "name": "mmt_class_provider.h",
      "doc": "The application and content class provider a plugin may register from init_proto()."
    },
    {
      "name": "proto_meta.h",
      "doc": "The ids of the core's pseudo-protocols, PROTO_UNKNOWN and PROTO_META; mmt_core.h includes it."
    },
    {
      "name": "tcpip/mmt_tcpip.h",
      "doc": "The ids of the libmmt_tcpip protocols, the parents most plugins classify under."
    }
  ],
  "types": [
    {
      "name": "mmt_proto_id_t",
      "header": "data_defs.h",
      "definition": "uint32_t",
      "doc": "A protocol id."
    },
    {
      "name": "mmt_proto_index_t",
      "header": "data_defs.h",
      "definition": "unsigned",
      "doc": "The index of a protocol in a packet's protocol path; the Java generator's int is wrong here."
    },
    {
      "name": "mmt_opaque_t",
      "header": "data_defs.h",
      "definition": "void *",
      "doc": "An opaque context or key pointer passed back to callbacks."
