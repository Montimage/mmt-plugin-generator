      "doc": "The opaque protocol structure being registered."
    },
    {
      "name": "mac_addr_t",
      "header": "types_defs.h",
      "doc": "A MAC address (an array of ETH_ALEN bytes); sizeof(mac_addr_t) is the data_len of an MMT_DATA_MAC_ADDR attribute."
    },
    {
      "name": "mmt_session_t",
      "header": "data_defs.h",
      "doc": "An opaque session (flow)."
    },
    {
      "name": "mmt_classify_verdict_t",
      "header": "plugin_defs.h",
      "doc": "What a classification callback returns, in C (C++ sees int)."
    }
  ],
