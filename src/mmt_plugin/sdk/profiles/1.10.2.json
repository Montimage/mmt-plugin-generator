    {"name": "BINARY_64DATA_TYPE_LEN", "header": "types_defs.h", "group": "data_len_or_offset", "doc": "Used as the data_len of an MMT_BINARY_DATA attribute: an int length and 64 data bytes."},
    {"name": "SCOPE_PACKET", "header": "mmt_core.h", "group": "scope", "doc": "PDL scope packet."},
