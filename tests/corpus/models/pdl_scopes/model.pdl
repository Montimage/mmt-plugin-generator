		attribute {
			alias="no_len" data_type="MMT_U16_DATA" offset="7" scope="SCOPE_PACKET"
		}
		attribute {
			alias="no_off" data_type="MMT_U8_DATA" data_len="1" scope="SCOPE_PACKET"
		}
