{#-
  The host harness of mmt-plugin test (mmt_plugin.testing.harness renders
  it, in memory, for one plugin and one set of packet tests). The plugin-side
  names (classification, set_classified_proto, the ipacket fields) come from
  the SDK profile, as in the scaffold's example; the host calls
  (init_extraction, mmt_init_handler, packet_process, the attribute
  lookups) are mmt-dpi's public API, and the compile against the SDK
  headers checks them.
-#}
/*
 * The mmt-plugin test harness of {{ name }} (protocol {{ proto_id }}, SDK profile {{ profile }}).
 *
 * Generated by mmt-plugin test; rebuilt on every run. It loads the plugins
 * of $MMT_DPI_PLUGINS_DIR with init_extraction(), attaches protocol
 * {{ proto_id }} to Ethernet itself (EtherType 0x{{ "%04x" % ethertype }}, so no parent hook
 * is needed), and processes the packets of a file (records of a 4-byte
 * little-endian length, then the bytes), each behind a 14-byte Ethernet
 * header in a buffer of its exact size.
 *
 *   harness check FILE   one block of lines per packet: the protocol index,
 *                        the next protocol and each attribute's value
 *   harness fuzz FILE    "at N" before packet N, every attribute read;
 *                        nothing else (a crash names its packet)
 *   harness bench FILE ROUNDS SAMPLES
 *                        "sample PACKETS NANOSECONDS", SAMPLES times
 *
 * Exit status: 0, or 3 with an "error" line when the setup fails.
 */
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>

{% for include in includes %}
#include "{{ include }}"
{% endfor %}
#include "mmt_core.h"

#define HARNESS_PROTO {{ proto_id }}
#define HARNESS_HEADER 14
#define HARNESS_ATTRIBUTES {{ attributes | length }}

enum harness_mode { HARNESS_CHECK, HARNESS_FUZZ, HARNESS_BENCH };

struct harness_type {
    int id;
    const char *name;
};

/* The data types of the profile, to print the type an attribute registered with. */
static const struct harness_type harness_types[] = {
{% for t in types %}
    {{ '{' }}{{ t }}, "{{ t }}"{{ '}' }},
{% endfor %}
};

struct harness_attribute {
    const char *name;
    unsigned length; /* the bytes printed for a type with no integer or binary form */
    uint32_t id;     /* 0: the plugin has no such attribute */
    int type;
};

/* The attributes the packet tests name; a last entry so the array is never empty. */
static struct harness_attribute harness_attributes[HARNESS_ATTRIBUTES + 1] = {
{% for a in attributes %}
    {{ '{' }}"{{ a.name }}", {{ a.length }}, 0, 0{{ '}' }},
{% endfor %}
    {NULL, 0, 0, 0},
};

static enum harness_mode harness_mode;
static volatile uint64_t harness_sink;

static const char *harness_type_name(int type)
{
    size_t i;

    for (i = 0; i < sizeof(harness_types) / sizeof(harness_types[0]); i++) {
        if (harness_types[i].id == type) {
            return harness_types[i].name;
        }
    }
    return "MMT_UNDEFINED_TYPE";
}

static {{ sdk.verdict_t }} harness_classify({{ sdk.ipacket_t }} *ipacket, unsigned previous_index)
{
    unsigned offset = (unsigned) {{ sdk.offset_at }}(ipacket, previous_index);
    {{ sdk.classified_proto_t }} next;

    if (ipacket->{{ sdk.ipacket_header }}->{{ sdk.caplen }} < offset + HARNESS_HEADER
        || ipacket->{{ sdk.ipacket_data }}[offset + 12] != 0x{{ "%02x" % (ethertype // 256) }}
        || ipacket->{{ sdk.ipacket_data }}[offset + 13] != 0x{{ "%02x" % (ethertype % 256) }}) {
        return {{ sdk.skip }};
    }
    memset(&next, 0, sizeof(next));
    next.{{ sdk.next_proto }} = HARNESS_PROTO;
    next.{{ sdk.next_offset }} = HARNESS_HEADER;
    next.{{ sdk.next_status }} = {{ sdk.classified }};
    if (!{{ sdk.set_classified_proto }}(ipacket, previous_index + 1, next)) {
        return {{ sdk.skip }};
    }
    return {{ sdk.matched }};
}

static void harness_hex(const uint8_t *p, size_t n)
{
    size_t i;

    for (i = 0; i < n; i++) {
        printf("%02x", p[i]);
    }
}

static uint64_t harness_uint(const void *value, size_t width)
{
    uint8_t u8;
    uint16_t u16;
    uint32_t u32;
    uint64_t u64;

    switch (width) {
    case 1:
        memcpy(&u8, value, 1);
        return u8;
    case 2:
        memcpy(&u16, value, 2);
        return u16;
    case 4:
        memcpy(&u32, value, 4);
        return u32;
    default:
        memcpy(&u64, value, 8);
        return u64;
    }
}

/* Reads (fuzz, bench) or prints (check) one extracted attribute. */
static void harness_attribute(const ipacket_t *ipacket, unsigned index, size_t i, const void *value)
{
    const struct harness_attribute *a = &harness_attributes[i];
    const mmt_binary_data_t *binary = value;
    const mmt_binary_var_data_t *var = value;
    const uint8_t *bytes = value;
    uint64_t sum = 0;
    size_t n, k;
    long offset;

    switch (a->type) {
    case MMT_U8_DATA:
    case MMT_DATA_CHAR:
        sum = harness_uint(value, 1);
        if (harness_mode == HARNESS_CHECK) {
            printf(" int %llu", (unsigned long long) sum);
        }
        break;
    case MMT_U16_DATA:
    case MMT_DATA_PORT:
        sum = harness_uint(value, 2);
        if (harness_mode == HARNESS_CHECK) {
            printf(" int %llu", (unsigned long long) sum);
        }
        break;
    case MMT_U32_DATA:
        sum = harness_uint(value, 4);
        if (harness_mode == HARNESS_CHECK) {
            printf(" int %llu", (unsigned long long) sum);
        }
        break;
    case MMT_U64_DATA:
        sum = harness_uint(value, 8);
        if (harness_mode == HARNESS_CHECK) {
            printf(" int %llu", (unsigned long long) sum);
        }
        break;
    case MMT_DATA_POINTER:
        /* The value is the pointer itself: report the offset it points at. */
        offset = (long) ((const uint8_t *) value - (ipacket->{{ sdk.ipacket_data }} + {{ sdk.offset_at }}(ipacket, index)));
        if (offset >= 0 && (uint64_t) offset < ipacket->{{ sdk.ipacket_header }}->{{ sdk.caplen }}) {
            sum = bytes[0];
        }
        if (harness_mode == HARNESS_CHECK) {
            printf(" ptr %ld", offset);
        }
        break;
    case MMT_BINARY_DATA:
    case MMT_STRING_DATA:
        n = binary->len < sizeof(binary->data) ? binary->len : sizeof(binary->data);
        for (k = 0; k < n; k++) {
            sum += binary->data[k];
        }
        if (harness_mode == HARNESS_CHECK) {
            printf(" hex ");
            harness_hex(binary->data, n);
        }
        break;
    case MMT_BINARY_VAR_DATA:
        n = var->len < sizeof(var->data) ? var->len : sizeof(var->data);
        for (k = 0; k < n; k++) {
            sum += var->data[k];
        }
        if (harness_mode == HARNESS_CHECK) {
            printf(" hex ");
            harness_hex(var->data, n);
        }
        break;
    default:
        for (k = 0; k < a->length; k++) {
            sum += bytes[k];
        }
        if (harness_mode == HARNESS_CHECK) {
            printf(" hex ");
            harness_hex(bytes, a->length);
        }
        break;
    }
    harness_sink += sum;
}

static int harness_packet(const ipacket_t *ipacket, mmt_opaque_t user)
{
    unsigned index = get_protocol_index_by_id(ipacket, HARNESS_PROTO);
    const void *value;
    size_t i;
    int next;

    (void) user;
    if (index == MMT_NO_PROTO_INDEX) {
        if (harness_mode == HARNESS_CHECK) {
            printf("proto none\n");
        }
        return 0;
    }
    if (harness_mode == HARNESS_CHECK) {
        printf("proto %u\n", index);
        next = (int) index + 1;
        if (next < ipacket->proto_hierarchy->len && ipacket->proto_hierarchy->proto_path[next] != PROTO_UNKNOWN) {
            printf("next %d %d\n", ipacket->proto_hierarchy->proto_path[next],
                   get_packet_offset_at_index(ipacket, (unsigned) next) - get_packet_offset_at_index(ipacket, index));
        } else {
            printf("next none\n");
        }
    }
    for (i = 0; i < HARNESS_ATTRIBUTES; i++) {
        if (harness_attributes[i].id == 0) {
            if (harness_mode == HARNESS_CHECK) {
                printf("attr %u missing\n", (unsigned) i);
            }
            continue;
        }
        value = get_attribute_extracted_data(ipacket, HARNESS_PROTO, harness_attributes[i].id);
        if (harness_mode == HARNESS_CHECK) {
            printf("attr %u %s", (unsigned) i, harness_type_name(harness_attributes[i].type));
        }
        if (value == NULL) {
            if (harness_mode == HARNESS_CHECK) {
                printf(" absent\n");
            }
            continue;
        }
        harness_attribute(ipacket, index, i, value);
        if (harness_mode == HARNESS_CHECK) {
            printf("\n");
        }
    }
    return 0;
}

struct harness_frame {
    unsigned char *data;
    size_t length;
};

/* The packets of path, each behind an Ethernet header, in buffers of their own size. */
static struct harness_frame *harness_read(const char *path, size_t *count)
{
    FILE *f = fopen(path, "rb");
    struct harness_frame *frames = NULL;
    unsigned char size[4];
    size_t n = 0, length;

    if (f == NULL) {
        return NULL;
    }
    while (fread(size, 1, 4, f) == 4) {
        struct harness_frame *grown = realloc(frames, (n + 1) * sizeof(*frames));

        if (grown == NULL) {
            fclose(f);
            return NULL;
        }
        frames = grown;
        length = (size_t) size[0] | (size_t) size[1] << 8 | (size_t) size[2] << 16 | (size_t) size[3] << 24;
        frames[n].length = HARNESS_HEADER + length;
        frames[n].data = malloc(frames[n].length);
        if (frames[n].data == NULL || fread(frames[n].data + HARNESS_HEADER, 1, length, f) != length) {
            fclose(f);
            return NULL;
        }
        memset(frames[n].data, 0, 12);
        frames[n].data[6] = 0x02; /* source 02:00:00:00:00:01, locally administered */
        frames[n].data[11] = 0x01;
        frames[n].data[12] = 0x{{ "%02x" % (ethertype // 256) }};
        frames[n].data[13] = 0x{{ "%02x" % (ethertype % 256) }};
        n++;
    }
    fclose(f);
    *count = n;
    return frames == NULL ? calloc(1, sizeof(*frames)) : frames;
}

static int harness_process(mmt_handler_t *handler, const struct harness_frame *frame, uint64_t seq)
{
    struct pkthdr header;

    memset(&header, 0, sizeof(header));
    header.ts.tv_sec = (long) (1 + seq);
    header.caplen = (unsigned) frame->length;
    header.len = (unsigned) frame->length;
    return packet_process(handler, &header, frame->data) ? 1 : 0;
}

static uint64_t harness_now(void)
{
    struct timespec t;

    clock_gettime(CLOCK_MONOTONIC, &t);
    return (uint64_t) t.tv_sec * 1000000000u + (uint64_t) t.tv_nsec;
}

static int harness_fail(const char *message)
{
    printf("error %s\n", message);
    fflush(stdout);
    return 3;
}

int main(int argc, char **argv)
{
    char error[MMT_ERRBUF_SIZE];
    mmt_handler_t *handler;
    struct harness_frame *frames;
    size_t count = 0, i;
    long rounds = 1, samples = 1, r, s;
    uint64_t start;

    if (argc < 3) {
        return harness_fail("usage: harness check|fuzz|bench FILE [ROUNDS SAMPLES]");
    }
    if (strcmp(argv[1], "check") == 0) {
        harness_mode = HARNESS_CHECK;
    } else if (strcmp(argv[1], "fuzz") == 0) {
        harness_mode = HARNESS_FUZZ;
    } else if (strcmp(argv[1], "bench") == 0 && argc == 5) {
        harness_mode = HARNESS_BENCH;
        rounds = strtol(argv[3], NULL, 10);
        samples = strtol(argv[4], NULL, 10);
    } else {
        return harness_fail("unknown mode");
    }
    frames = harness_read(argv[2], &count);
    if (frames == NULL) {
        return harness_fail("cannot read the packet file");
    }
    if (!init_extraction()) {
        return harness_fail("init_extraction() failed: a plugin did not load");
    }
    if (!is_registered_protocol(HARNESS_PROTO)) {
        return harness_fail("the plugin did not register protocol {{ proto_id }}");
    }
    printf("protocol %d %s\n", HARNESS_PROTO, get_protocol_name_by_id(HARNESS_PROTO));
    if (!{{ sdk.with_parent }}({{ sdk.ethernet }}, harness_classify, 1)) {
        return harness_fail("cannot attach the protocol to Ethernet");
    }
    handler = mmt_init_handler(DLT_EN10MB, 0, error);
    if (handler == NULL) {
        return harness_fail("mmt_init_handler() failed");
    }
    for (i = 0; i < HARNESS_ATTRIBUTES; i++) {
        struct harness_attribute *a = &harness_attributes[i];

        a->id = get_attribute_id_by_protocol_id_and_attribute_name(HARNESS_PROTO, a->name);
        if (a->id == 0) {
            continue;
        }
        a->type = (int) get_attribute_data_type(HARNESS_PROTO, a->id);
        if (!register_extraction_attribute(handler, HARNESS_PROTO, a->id)) {
            return harness_fail("cannot register an attribute for extraction");
        }
    }
    if (!register_packet_handler(handler, 1, harness_packet, NULL)) {
        return harness_fail("cannot register the packet handler");
    }
    fflush(stdout);
    if (harness_mode == HARNESS_BENCH) {
        for (s = 0; s < samples; s++) {
            start = harness_now();
            for (r = 0; r < rounds; r++) {
                for (i = 0; i < count; i++) {
                    harness_process(handler, &frames[i], (uint64_t) i);
                }
            }
            printf("sample %llu %llu\n", (unsigned long long) ((uint64_t) rounds * count),
                   (unsigned long long) (harness_now() - start));
        }
    } else {
        for (i = 0; i < count; i++) {
            printf(harness_mode == HARNESS_CHECK ? "packet %llu\n" : "at %llu\n", (unsigned long long) i);
            fflush(stdout);
            if (!harness_process(handler, &frames[i], (uint64_t) i)) {
                printf("unprocessed\n");
            }
            if (harness_mode == HARNESS_CHECK) {
                printf("done\n");
            }
        }
    }
    printf("end %llu\n", (unsigned long long) count);
    fflush(stdout);
    mmt_close_handler(handler);
    close_extraction();
    for (i = 0; i < count; i++) {
        free(frames[i].data);
    }
    free(frames);
    return 0;
}
