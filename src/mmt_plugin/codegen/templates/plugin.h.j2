{#-
  The plugin header: mmt_plugin.codegen renders it from a cgen.Context.
  Policy (mmt_plugin.codegen.ENVIRONMENT): StrictUndefined, no autoescape,
  trim_blocks and lstrip_blocks, so a {% tag %} line leaves nothing behind.
  Every SDK name comes from the context (the profile), never from here.
-#}
/*
 * {{ header }}: the {{ name }} protocol plugin for mmt-dpi (SDK profile {{ profile }}).
 *
 * Generated by mmt-plugin generate from a PDL v1 model. Do not edit: generate
 * refuses to overwrite a hand-edited file (--force discards the edit). Your
 * code goes in src/{{ lc }}_impl.c, which defines the hooks declared below.
 */
#ifndef {{ guard }}
#define {{ guard }}

#include <stdint.h>
{% for h in h_includes %}
#include "{{ h }}"
{% endfor %}

#ifdef __cplusplus
extern "C" {
#endif

#define {{ proto_macro }} {{ id }}
#define {{ proto_alias_macro }} "{{ name }}"
{% if defines %}

/* The model's defines. */
{% for d in defines %}
#define {{ d.name }} {{ d.value }}{% if d.alias_of %} /* {{ d.alias_of }} */{% endif %}

{% endfor %}
{% endif %}

/* Attribute ids: unconditional attributes first, then conditional ones. */
enum {{ lc }}_attributes {
{% for a in attributes_by_id %}
    {{ a.enum }} = {{ a.id }},
{% endfor %}
    {{ nb }} = {{ attributes_by_id | length }}
};
{% if attributes_by_id %}

/* Attribute names, as registered. */
{% for a in attributes_by_id %}
#define {{ a.alias_macro }} "{{ a.key }}"
{% endfor %}
{% endif %}
{% if structs %}

/*
 * The model's structs, laid out as on the wire (the generated source checks
 * each layout with _Static_assert). Multi-byte members hold wire bytes, so
 * read a packet with the extraction functions, not through these structs.
 */
{% for s in structs %}

/* {{ s.comment }} */
struct {{ s.tag }} {
{% for m in s.members %}
    {{ m.type }} {{ m.name }}{% if m.array %}[{{ m.array }}]{% endif %};{% if m.comment %} /* {{ m.offset }}: {{ m.comment }} */{% endif %}

{% endfor %}
}{% if s.packed %} __attribute__((packed)){% endif %};
{% endfor %}
{% endif %}

/*
 * Hooks: define each one in src/{{ lc }}_impl.c. A hook that is missing fails
 * the build of the plugin.
 */
{% for h in hooks %}

/* {{ h.doc }} */
{{ h.declaration }};
{% endfor %}

/* Registers the protocol and its attributes with mmt-dpi; 1 on success. */
{{ init_declaration }};

#ifndef CORE
/* The plugin entry point that mmt-dpi calls when it loads the plugin. */
{{ init_proto_declaration }};
#endif

#ifdef __cplusplus
}
#endif

#endif /* {{ guard }} */
